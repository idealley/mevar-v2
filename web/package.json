{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "CONTENT_SOURCES=mevar astro dev",
    "dev:all": "astro dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' astro build && pagefind --site dist",
    "preview": "astro preview",
    "check:dist": "node scripts/check-dist.mjs",
    "astro": "astro",
    "check:limits": "node scripts/check-pages-limits.mjs",
    "deploy": "npm run build && npm run check:limits && npx wrangler@4 pages deploy dist --project-name=mevar"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^8.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^6.2.2",
    "clsx": "^2.1.1",
    "svelte": "^5.55.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "tailwind-variants": "^3.2.2"
  }
}
