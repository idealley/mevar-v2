---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import ArchiveBlock from "../../components/ArchiveBlock.astro";
import { categoryWorks, PAGE_SIZE } from "$lib/works";

export const getStaticPaths = (async ({ paginate }) => {
  const { mevar, archive } = await categoryWorks("predications");
  return paginate(mevar, { pageSize: PAGE_SIZE, props: { archive } });
}) satisfies GetStaticPaths;

const { page, archive } = Astro.props;
---

<Layout title="Prédications · Mevar" description={`${page.total} prédications de la mission MEVAR`}>
  <CategoryGrid
    title="Prédications"
    description="Les prédications de la mission MEVAR."
    page={page}
  >
    <ArchiveBlock category="predications" archive={archive} />
  </CategoryGrid>
</Layout>
