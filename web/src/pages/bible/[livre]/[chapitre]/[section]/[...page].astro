---
// /bible/<livre>/<chapitre>/<verset>/ and .../tout/: a verse, or the whole
// chapter, cited by more works than the chapter page lists, PAGE_SIZE a page.
import type { GetStaticPaths } from "astro";
import Layout from "../../../../../layouts/Layout.astro";
import BackBar from "../../../../../components/BackBar.astro";
import PageHead from "../../../../../components/PageHead.astro";
import Pagination from "../../../../../components/Pagination.astro";
import VerseWorks from "../../../../../components/VerseWorks.astro";
import { PAGE_SIZE, bibleChapters } from "$lib/works";
import { bookName, chapterUrl } from "$lib/bible.mjs";

export const getStaticPaths = (async ({ paginate }) => {
  const pages = [];
  for (const c of (await bibleChapters()).values()) {
    const url = chapterUrl(c.book, c.chapter);
    const [, , livre, chapitre] = url.split("/");
    const name = `${bookName(c.book)} ${c.chapter}`;
    const sections = [
      { section: "tout", title: `${name}, tout le chapitre`, anchor: "tout", works: c.whole },
      ...[...c.verses].map(([v, works]) => ({ section: String(v), title: `${name}:${v}`, anchor: `v${v}`, works })),
    ];
    for (const s of sections) {
      if (s.works.length <= PAGE_SIZE) continue;
      const back = `${url}#${s.anchor}`;
      pages.push(...paginate(s.works, { pageSize: PAGE_SIZE, params: { livre, chapitre, section: s.section }, props: { title: s.title, back, name } }));
    }
  }
  return pages;
}) satisfies GetStaticPaths;

const { page, title, back, name } = Astro.props;
---

<Layout title={`${title} · Mevar`} description={`${page.total} textes citent ${title}`}>
  <BackBar slot="bar" href={back} label={name} />
  <PageHead
    crumbs={[{ href: "/", label: "Accueil" }, { href: "/bible/", label: "Écritures" }, { href: back, label: name }]}
    eyebrow={`${page.total.toLocaleString("fr-FR")} textes, page ${page.currentPage} sur ${page.lastPage}`}
    title={title}
  />
  <div class="mx-auto max-w-[1440px] px-10 pb-[72px] max-lg:px-4 max-lg:pb-10">
    <div class="max-w-[860px]">
      <VerseWorks works={page.data} />
      <Pagination page={page} />
    </div>
  </div>
</Layout>
