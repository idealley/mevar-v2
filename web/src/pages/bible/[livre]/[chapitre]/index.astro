---
// /bible/<livre>/<chapitre>/: the works citing each verse of a chapter, whole-
// chapter references first. A section of more than PAGE_SIZE works shows its
// first ones and links to its own paginated page ([section]/).
import Layout from "../../../../layouts/Layout.astro";
import BackBar from "../../../../components/BackBar.astro";
import PageHead from "../../../../components/PageHead.astro";
import VerseWorks from "../../../../components/VerseWorks.astro";
import { PAGE_SIZE, bibleChapters, type Chapter } from "$lib/works";
import { bookName, bookUrl, chapterUrl } from "$lib/bible.mjs";

export async function getStaticPaths() {
  return [...(await bibleChapters()).values()].map((c) => {
    const [, , livre, chapitre] = chapterUrl(c.book, c.chapter).split("/");
    return { params: { livre, chapitre }, props: { c } };
  });
}

const { c } = Astro.props as { c: Chapter };
const name = `${bookName(c.book)} ${c.chapter}`;
const url = chapterUrl(c.book, c.chapter);
const SHOWN = 10;
const sections = [
  ...(c.whole.length ? [{ id: "tout", title: `${name}, tout le chapitre`, works: c.whole }] : []),
  ...[...c.verses.keys()].sort((a, b) => a - b).map((v) => ({ id: `v${v}`, title: `${name}:${v}`, works: c.verses.get(v)! })),
];
---

<Layout title={`${name} · Mevar`} description={`Les prédications et études qui citent ${name}`}>
  <BackBar slot="bar" href={bookUrl(c.book)} label={bookName(c.book)} />
  <PageHead
    crumbs={[{ href: "/", label: "Accueil" }, { href: "/bible/", label: "Écritures" }, { href: bookUrl(c.book), label: bookName(c.book) }]}
    title={name}
    intro={`Les textes de la bibliothèque qui citent ${name}, verset par verset : ceux de la mission d'abord, puis les archives.`}
  />
  <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-10 pb-[72px] max-lg:gap-7 max-lg:px-4 max-lg:pb-10">
    {sections.map((s) => (
      <section id={s.id} class="max-w-[860px]">
        <h2 class="eyebrow pb-3 text-accent">{s.title}</h2>
        {s.works.length > PAGE_SIZE ? (
          <>
            <VerseWorks works={s.works.slice(0, SHOWN)} />
            <p class="border-t pt-4">
              <a href={`${url}${s.id.replace(/^v/, "")}/`} class="chip">Les {s.works.length.toLocaleString("fr-FR")} textes</a>
            </p>
          </>
        ) : (
          <VerseWorks works={s.works} />
        )}
      </section>
    ))}
  </div>
</Layout>
