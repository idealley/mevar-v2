---
import Layout from "../layouts/Layout.astro";
import Browse from "../components/Browse.astro";
import PageHead from "../components/PageHead.astro";
import { tags, worksTagged } from "$lib/works";

// Topical Ghost tags only: years, places and months have their pages, not a place here.
const themes = [];
for (const tag of tags.values()) {
  if (!tag.theme) continue;
  const n = (await worksTagged(tag.name)).length;
  if (n) themes.push({ ...tag, n });
}
themes.sort((a, b) => b.n - a.n);
---

<Layout title="Thèmes · Mevar" description="Parcourir les publications par thème">
  <PageHead eyebrow={`${themes.length} thèmes`} title="Thèmes" intro="Parcourir la bibliothèque par sujet." />
  <Browse />
  <div class="mx-auto flex max-w-[1440px] flex-wrap gap-2.5 px-10 pb-[72px] max-lg:gap-2 max-lg:px-4 max-lg:pb-10">
    {themes.map((t) => (
      <a href={t.url} class="chip items-center gap-2">{t.name}<span class="text-xs font-normal text-ink-2">{t.n}</span></a>
    ))}
  </div>
</Layout>
