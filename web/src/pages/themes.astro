---
import Layout from "../layouts/Layout.astro";
import { tags, worksTagged } from "$lib/works";

// Topical Ghost tags only: years, places and months have their pages, not a place here.
const themes = [];
for (const tag of tags.values()) {
  if (!tag.theme) continue;
  const n = (await worksTagged(tag.name)).length;
  if (n) themes.push({ ...tag, n });
}
themes.sort((a, b) => b.n - a.n);
---

<Layout title="Thèmes — Mevar" description="Parcourir les publications par thème">
  <div class="container mx-auto px-4 py-12 md:py-16">
    <header class="max-w-2xl mb-10">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">Thèmes</h1>
      <p class="text-lg text-muted-foreground">
        Parcourir la bibliothèque par sujet. {themes.length} thèmes recensés.
      </p>
    </header>
    <div class="flex flex-wrap gap-2">
      {themes.map((t) => (
        <a href={t.url} class="inline-flex items-center gap-2 rounded-full border bg-card px-4 py-2 text-sm hover:border-primary/50 transition">
          <span>{t.name}</span>
          <span class="text-xs text-muted-foreground">{t.n}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
