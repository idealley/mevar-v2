---
import Layout from "../layouts/Layout.astro";
import WorkCard from "../components/WorkCard.astro";
import { recentMevar, corpusCounts } from "$lib/works";

const featured = await recentMevar(6);
const counts = await corpusCounts();
---

<Layout>
  <section class="border-b bg-gradient-to-b from-background to-muted/30">
    <div class="container mx-auto px-4 py-16 md:py-24 text-center">
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
        Étude de la Parole<br /><span class="text-muted-foreground">pour le temps de la fin</span>
      </h1>
      <p class="max-w-2xl mx-auto text-lg text-muted-foreground mb-8">
        Une bibliothèque numérique reliant prédications, exhortations, études bibliques et livres
        — chaque référence connectée au texte original et aux écrits qui en parlent.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/predications" class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition">
          Parcourir la bibliothèque
        </a>
        <a href="/recherche" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-6 py-3 text-sm font-medium hover:bg-accent hover:text-accent-foreground transition">
          Recherche par verset
        </a>
      </div>
    </div>
  </section>

  <section class="border-b">
    <div class="container mx-auto px-4 py-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-center">
        <a href="/predications" class="group">
          <div class="text-2xl font-bold group-hover:text-primary transition">{counts.sermons.toLocaleString("fr-FR")}</div>
          <div class="text-xs uppercase tracking-wide text-muted-foreground mt-1">prédications</div>
        </a>
        <a href="/exhortations" class="group">
          <div class="text-2xl font-bold group-hover:text-primary transition">{counts.exhortations}</div>
          <div class="text-xs uppercase tracking-wide text-muted-foreground mt-1">exhortations</div>
        </a>
        <a href="/etudes-bibliques" class="group">
          <div class="text-2xl font-bold group-hover:text-primary transition">{counts.studies}</div>
          <div class="text-xs uppercase tracking-wide text-muted-foreground mt-1">études bibliques</div>
        </a>
        <a href="/publications" class="group">
          <div class="text-2xl font-bold group-hover:text-primary transition">{(counts.books + counts.articles).toLocaleString("fr-FR")}</div>
          <div class="text-xs uppercase tracking-wide text-muted-foreground mt-1">publications</div>
        </a>
        <div>
          <div class="text-2xl font-bold">{counts.total.toLocaleString("fr-FR")}</div>
          <div class="text-xs uppercase tracking-wide text-muted-foreground mt-1">total</div>
        </div>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-12">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold tracking-tight">Récemment publié</h2>
      <a href="/predications" class="text-sm text-muted-foreground hover:text-foreground transition">Tout voir →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>
</Layout>
