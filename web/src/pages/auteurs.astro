---
import Layout from "../layouts/Layout.astro";
import { PREACHERS, worksBy } from "$lib/works";

const rows = [];
for (const p of PREACHERS) {
  const count = (await worksBy(p)).length;
  if (count) rows.push({ ...p, count });
}
rows.sort((a, b) => b.count - a.count);
const groups = [
  { title: undefined, rows: rows.filter((p) => !p.archive) },
  { title: "Archives", rows: rows.filter((p) => p.archive) },
];
---

<Layout title="Auteurs · Mevar" description="Auteurs des prédications, exhortations et études bibliques de Mevar">
  <div class="container mx-auto px-4 py-12 md:py-16">
    <header class="max-w-2xl mb-10">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">Auteurs</h1>
      <p class="text-lg text-muted-foreground">
        Les voix qui portent le message au sein de la mission MEVAR.
      </p>
    </header>
    {groups.map((g) => (
      <section class={g.title ? "mt-14" : undefined}>
        {g.title && <h2 class="text-xl font-semibold tracking-tight mb-4">{g.title}</h2>}
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {g.rows.map((a) => (
            <li>
              <a href={`/auteurs/${a.slug}/`} class="block rounded-lg border bg-card p-5 hover:border-primary/50 transition">
                <div class="font-semibold text-lg">{a.name}</div>
                <div class="text-sm text-muted-foreground mt-1">
                  {a.count.toLocaleString("fr-FR")} publication{a.count > 1 ? "s" : ""}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
