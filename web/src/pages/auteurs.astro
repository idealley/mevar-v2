---
import Layout from "../layouts/Layout.astro";
import Browse from "../components/Browse.astro";
import PageHead from "../components/PageHead.astro";
import { PREACHERS, worksBy } from "$lib/works";

const rows = [];
for (const p of PREACHERS) {
  const count = (await worksBy(p)).length;
  if (count) rows.push({ ...p, count });
}
rows.sort((a, b) => b.count - a.count);
const groups = [
  { title: undefined, rows: rows.filter((p) => !p.archive) },
  { title: "Archives", rows: rows.filter((p) => p.archive) },
];
---

<Layout title="Auteurs · Mevar" description="Auteurs des prédications, exhortations et études bibliques de Mevar">
  <PageHead eyebrow="La mission" title="Auteurs" intro="Les voix qui portent le message au sein de la mission MEVAR." />
  <Browse />
  <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-10 pb-[72px] max-lg:gap-6 max-lg:px-4 max-lg:pb-10">
    {groups.map((g) => g.rows.length > 0 && (
      <section class="flex flex-col gap-5 max-lg:gap-3">
        {g.title && <h2 class="eyebrow">{g.title}</h2>}
        <ul class="grid grid-cols-3 gap-[22px] max-lg:grid-cols-1 max-lg:gap-2.5">
          {g.rows.map((a) => (
            <li>
              <a href={`/auteurs/${a.slug}/`} class="hair flex items-center gap-3.5 rounded-[18px] p-[22px] hover:bg-surface max-lg:p-4">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink font-display text-[19px] text-on-invert">{a.name[0]}</span>
                <span class="flex flex-col gap-0.5">
                  <span class="font-display text-[23px] leading-[26px]">{a.name}</span>
                  <span class="text-[13px] leading-4 text-ink-2">{a.count.toLocaleString("fr-FR")} texte{a.count > 1 ? "s" : ""}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
