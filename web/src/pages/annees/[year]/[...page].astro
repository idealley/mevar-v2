---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import CategoryGrid from "../../../components/CategoryGrid.astro";
import { PAGE_SIZE, tags, worksTagged } from "$lib/works";

// Ghost's year tags.
export const getStaticPaths = (async ({ paginate }) => {
  const pages = [];
  for (const tag of tags.values()) {
    if (!tag.url.startsWith("/annees/")) continue;
    const entries = await worksTagged(tag.name);
    if (entries.length) pages.push(...paginate(entries, { pageSize: PAGE_SIZE, params: { year: tag.slug } }));
  }
  return pages;
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { year } = Astro.params;
---

<Layout title={`${year} · Mevar`} description={`${page.total} publications de ${year}`}>
  <CategoryGrid title={year} page={page} />
</Layout>
