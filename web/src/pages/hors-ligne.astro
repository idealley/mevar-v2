---
// Served by the service worker when a page was never opened and the network
// is down. Precached with the shell; see astro.config.mjs.
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
---

<Layout title="Hors ligne · Mevar">
  <PageHead
    eyebrow="Sans connexion"
    title="Vous êtes hors ligne"
    intro="Cette page n’a pas encore été ouverte sur cet appareil, elle n’est donc pas disponible sans connexion. Les pages que vous avez déjà lues restent lisibles hors ligne."
  />
  <p class="mx-auto flex max-w-[1440px] flex-wrap gap-2.5 px-10 pb-[72px] max-lg:px-4 max-lg:pb-10">
    <a href="/mes-lectures/" class="chip">Mes lectures</a>
    <a href="/" class="chip">Retour à l’accueil</a>
  </p>
</Layout>
