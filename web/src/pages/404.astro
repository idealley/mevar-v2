---
// dist/404.html. Cloudflare Pages serves it, with status 404, for any path
// that is not a page; without it, Pages answers every unknown path with the
// home page and status 200.
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
---

<Layout title="Page introuvable · Mevar">
  <PageHead eyebrow="Erreur 404" title="Page introuvable" intro="Cette adresse ne mène à aucune page de la bibliothèque." />
  <p class="mx-auto flex max-w-[1440px] flex-wrap gap-2.5 px-10 pb-[72px] max-lg:px-4 max-lg:pb-10">
    <a href="/recherche/" class="chip">Rechercher</a>
    <a href="/" class="chip">Revenir à l’accueil</a>
  </p>
</Layout>
