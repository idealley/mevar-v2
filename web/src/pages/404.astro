---
// dist/404.html. Cloudflare Pages serves it, with status 404, for any path
// that is not a page; without it, Pages answers every unknown path with the
// home page and status 200.
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable · Mevar">
  <div class="container mx-auto px-4 py-16 max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight mb-4">Page introuvable</h1>
    <p class="text-lg text-muted-foreground mb-4">
      Cette adresse ne mène à aucune page de la bibliothèque.
    </p>
    <p class="text-lg text-muted-foreground">
      <a href="/recherche/" class="text-primary underline">Rechercher</a>
      ou <a href="/" class="text-primary underline">revenir à l’accueil</a>.
    </p>
  </div>
</Layout>
