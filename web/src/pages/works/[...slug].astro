---
import WorkPage from "../../components/WorkPage.astro";
import { allWorks } from "$lib/works";

// Ghost posts are at their root URL (../[slug].astro), not here.
export async function getStaticPaths() {
  const works = await allWorks();
  return works
    .filter((entry) => entry.data.source !== "mevar")
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<WorkPage entry={entry} />
