---
import WorkPage from "../../components/WorkPage.astro";
import { allWorks } from "$lib/works";

// The works under markdown/mevar/ are at their root URL (../[slug].astro), not here.
export async function getStaticPaths() {
  const works = await allWorks();
  return works
    .filter((entry) => !entry.id.startsWith("mevar/"))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<WorkPage entry={entry} />
