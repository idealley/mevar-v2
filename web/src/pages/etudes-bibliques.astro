---
import Layout from "../layouts/Layout.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import { worksByKind } from "$lib/works";

const entries = await worksByKind("bible_study");
---

<Layout title="Études bibliques — Mevar" description={`${entries.length} études bibliques`}>
  <CategoryGrid
    title="Études bibliques"
    description="Études thématiques approfondies, organisées par sujet."
    entries={entries}
  />
</Layout>
