---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import { worksByKind, PAGE_SIZE } from "$lib/works";

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await worksByKind("bible_study");
  return paginate(entries, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title="Études bibliques — Mevar" description={`${page.total} études bibliques`}>
  <CategoryGrid
    title="Études bibliques"
    description="Études thématiques approfondies, organisées par sujet."
    page={page}
  />
</Layout>
