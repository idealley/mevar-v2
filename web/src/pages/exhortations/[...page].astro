---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import ArchiveBlock from "../../components/ArchiveBlock.astro";
import { categoryWorks, PAGE_SIZE } from "$lib/works";

export const getStaticPaths = (async ({ paginate }) => {
  const { mevar, archive } = await categoryWorks("exhortations");
  return paginate(mevar, { pageSize: PAGE_SIZE, props: { archive } });
}) satisfies GetStaticPaths;

const { page, archive } = Astro.props;
---

<Layout title="Exhortations · Mevar" description={`${page.total} exhortations de la mission MEVAR`}>
  <CategoryGrid
    title="Exhortations"
    description="Paroles d'exhortation publiées chaque mois pour affermir les croyants dans la foi."
    page={page}
  >
    <ArchiveBlock category="exhortations" archive={archive} />
  </CategoryGrid>
</Layout>
