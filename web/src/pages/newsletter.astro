---
import MevarPage from "../components/MevarPage.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
---
<MevarPage slug="newsletter" fallbackTitle="Newsletter">
  <div class="mt-[30px] flex max-w-[648px] flex-col items-start gap-5">
    <p class="text-[17px] leading-[27px] text-ink-2">
      Recevez un e-mail à chaque nouvelle publication sur mevar.org. Vous pouvez vous
      désinscrire à tout moment, par le lien en bas de chaque e-mail.
    </p>
    <NewsletterForm origin="newsletter-page" />
  </div>
</MevarPage>
