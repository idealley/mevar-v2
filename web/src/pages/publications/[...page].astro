---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import { allWorks, PAGE_SIZE } from "$lib/works";
import { deriveKind } from "$lib/utils";

export const getStaticPaths = (async ({ paginate }) => {
  const all = await allWorks();
  // Publications = books + articles + chapters
  const entries = all.filter((e) => {
    const k = deriveKind(e.data);
    return k === "book" || k === "article" || k === "chapter";
  });
  return paginate(entries, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title="Publications — Mevar" description={`${page.total} publications`}>
  <CategoryGrid
    title="Publications"
    description="Livres, articles et publications de fond — œuvres de référence pour l'étude personnelle."
    page={page}
  />
</Layout>
