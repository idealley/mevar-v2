---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import ArchiveBlock from "../../components/ArchiveBlock.astro";
import { categoryWorks, PAGE_SIZE } from "$lib/works";

export const getStaticPaths = (async ({ paginate }) => {
  const { mevar, archive } = await categoryWorks("publications");
  return paginate(mevar, { pageSize: PAGE_SIZE, props: { archive } });
}) satisfies GetStaticPaths;

const { page, archive } = Astro.props;
---

<Layout title="Publications · Mevar" description={`${page.total} publications de la mission MEVAR`}>
  <CategoryGrid
    title="Publications"
    description="Livres, articles et publications de fond, œuvres de référence pour l'étude personnelle."
    page={page}
  >
    <ArchiveBlock category="publications" archive={archive} />
  </CategoryGrid>
</Layout>
