---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Recherche · Mevar" description="Recherche dans la bibliothèque Mevar">
  <div class="container mx-auto px-4 py-12 md:py-16 max-w-2xl">
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">Recherche</h1>
      <p class="text-lg text-muted-foreground">
        Dans le texte de toutes les prédications, exhortations, études et
        publications, en français et en anglais. Filtres par prédicateur,
        année et source.
      </p>
    </header>
    <!-- The index and its UI load on first focus, not with the page. -->
    <input
      id="search-start"
      type="search"
      aria-label="Rechercher"
      placeholder="Un mot, une phrase, un titre"
      class="w-full rounded-md border bg-background px-4 py-3 text-lg"
    />
    <div id="search"></div>
  </div>
</Layout>

<script>
  const start = document.getElementById("search-start") as HTMLInputElement;

  function load() {
    start.removeEventListener("focus", load);
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = "/pagefind/pagefind-ui.css";
    document.head.append(css);
    const js = document.createElement("script");
    js.src = "/pagefind/pagefind-ui.js";
    js.onload = () => {
      // @ts-expect-error PagefindUI is the global pagefind-ui.js defines
      const ui = new PagefindUI({
        element: "#search",
        showImages: false,
      });
      start.remove();
      const input = document.querySelector<HTMLInputElement>("#search input");
      input?.focus();
      if (start.value) ui.triggerSearch(start.value);
    };
    document.head.append(js);
  }

  start.addEventListener("focus", load);
</script>
