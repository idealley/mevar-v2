---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Recherche — Mevar" description="Recherche dans la bibliothèque Mevar">
  <div class="container mx-auto px-4 py-12 md:py-16 max-w-2xl">
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">Recherche</h1>
      <p class="text-lg text-muted-foreground">
        Recherche plein-texte avec filtres par verset, auteur, lieu, ou date.
      </p>
    </header>
    <div class="rounded-lg border bg-card p-8 text-center">
      <p class="text-muted-foreground mb-4">
        L'index de recherche est en construction.
      </p>
      <p class="text-sm text-muted-foreground">
        Indexation prévue avec SurrealDB BM25 + recherche vectorielle. En attendant,
        utilisez la navigation par catégorie ou par thème.
      </p>
      <div class="flex justify-center gap-3 mt-6">
        <a href="/predications/" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition">
          Prédications
        </a>
        <a href="/themes/" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-accent transition">
          Thèmes
        </a>
      </div>
    </div>
  </div>
</Layout>
