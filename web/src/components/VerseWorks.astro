---
// The works citing a verse (or a whole chapter): Mevar first, then the
// archive under its own label. Titles and preachers only: no Bible text.
import { dots, isMevar, preacherOf, workUrl, type WorkEntry } from "$lib/works";

interface Props {
  works: WorkEntry[];
}

const { works } = Astro.props;
const groups = [works.filter(isMevar), works.filter((e) => !isMevar(e))];
---

{groups.map((list, i) => list.length > 0 && (
  <>
    {i === 1 && <p class="pt-4 text-[10px] leading-3 font-semibold tracking-[1.8px] text-ink-2 uppercase">Archives</p>}
    <ul class="flex flex-col">
      {list.map((e) => (
        <li class="flex items-baseline justify-between gap-6 border-t py-3 max-lg:flex-col max-lg:gap-1">
          <a href={workUrl(e)} class="font-display text-[21px] leading-[25px] hover:text-accent max-lg:text-xl max-lg:leading-[23px]">{e.data.title ?? e.id}</a>
          <span class="shrink-0 text-[13px] leading-4 text-ink-2 max-lg:text-[11px] max-lg:leading-[13px]">{dots(preacherOf(e), e.data.year)}</span>
        </li>
      ))}
    </ul>
  </>
))}
