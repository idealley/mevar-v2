---
import type { Page } from "astro";
import Browse from "./Browse.astro";
import PageHead from "./PageHead.astro";
import Pagination from "./Pagination.astro";
import WorkCard from "./WorkCard.astro";
import type { WorkEntry } from "$lib/works";

interface Props {
  page: Page<WorkEntry>;
  title: string;
  description?: string;
}

const { page, title, description } = Astro.props;
const count = `${page.total.toLocaleString("fr-FR")} texte${page.total > 1 ? "s" : ""}${page.lastPage > 1 ? `, page ${page.currentPage} sur ${page.lastPage}` : ""}`;
---

<PageHead eyebrow={count} title={title} intro={description} />
<Browse />
<section class="mx-auto max-w-[1440px] px-10 pb-[72px] max-lg:px-4 max-lg:pb-10">
  {page.total === 0 ? (
    <p class="text-ink-2">Aucun texte pour le moment.</p>
  ) : (
    <div class="grid grid-cols-3 gap-[22px] max-lg:grid-cols-1 max-lg:gap-0">
      {page.data.map((entry) => <WorkCard entry={entry} />)}
    </div>
  )}
  <Pagination page={page} />
  <slot />
</section>
