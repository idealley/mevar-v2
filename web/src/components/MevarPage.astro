---
import Layout from "../layouts/Layout.astro";
import PageHead from "./PageHead.astro";
import { getEntry, render } from "astro:content";

interface Props {
  slug: string;
  fallbackTitle?: string;
}

const { slug, fallbackTitle } = Astro.props;
const entry = await getEntry("works", `mevar/${slug}`);
if (!entry) {
  return new Response(`Mevar page "${slug}" missing — run the Ghost ingest first.`, { status: 500 });
}
const { Content } = await render(entry);
const fm = entry.data;
const title = fm.title ?? fallbackTitle ?? slug;
---

<Layout title={`${title} — Mevar`} description={fm.summary ?? title}>
  <article>
    <PageHead eyebrow="Mevar" title={title} intro={fm.subtitle ?? undefined} />
    <div class="mx-auto max-w-[1440px] px-10 pb-[76px] max-lg:px-5 max-lg:pb-10">
      <div class="prose-reader max-w-[648px]">
        <Content />
      </div>
      <slot />
    </div>
  </article>
</Layout>
