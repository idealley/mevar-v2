---
// The page of one work, whatever its source: /<slug>/ for a Ghost post,
// /works/<source>/<path>/ for the rest.
import Layout from "../layouts/Layout.astro";
import BackBar from "./BackBar.astro";
import Crumbs from "./Crumbs.astro";
import Icon from "./Icon.astro";
import JsonLd from "./JsonLd.astro";
import SectionHead from "./SectionHead.astro";
import WorkCard from "./WorkCard.astro";
import { render } from "astro:content";
import { slug } from "github-slugger";
import { refUrl } from "$lib/bible.mjs";
import { formatDateFr } from "$lib/utils";
import {
  ARCHIVE_SOURCES, PREACHERS, allWorks, categoryOf, dots, entryDate, excerptOf, isMevar, kindLabel, minutes, nextWorks,
  preacherOf, refsOf, shortDate, tags, workAt, workUrl, worksBy, type WorkEntry,
} from "$lib/works";

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const fm = entry.data;
const title = fm.title ?? entry.id;
// The day it was published or preached, or the year alone when that is all a work has.
const published = entryDate(entry).slice(0, 10) || (fm.year ? String(fm.year) : undefined);
const date = formatDateFr(entryDate(entry).slice(0, 10) || null);
// Branham's own text is English; everything else is French.
const lang = fm.source === "branham" ? "en" : "fr";
const preacher = preacherOf(entry);
const author = PREACHERS.find((p) => p.name === preacher);
const authorCount = author ? (await worksBy(author)).length : 0;
// A Mevar text offers the PDF of its text first, and its original beside it
// where it has one (goal 23); every other work, its one PDF.
const originalPdf = (fm.local_pdf as string | undefined) ?? fm.pdf_url;
const textPdf = fm.text_pdf as string | undefined;
const pdf = textPdf ?? originalPdf;
// A recording on R2, played on the page (goals 25, 26); a remote one only
// where there is none; and a Ghost post's YouTube video.
const audio = fm.local_audio as string | undefined;
const remoteAudio = audio ? undefined : fm.audio_url;
const video = fm.video_url as string | undefined;

const series = fm.series
  ? (await allWorks())
      .filter((e) => e.data.series === fm.series)
      .sort((a, b) => (a.data.series_part as number) - (b.data.series_part as number))
  : [];
const at = series.findIndex((e) => e.id === entry.id);
const [previous, next] = [series[at - 1], series[at + 1]];

// A Le-Scribe summary and the Branham sermon it summarizes.
const original = fm.original ? await workAt(fm.original as string) : undefined;
const summaryFr = fm.summary_fr ? await workAt(fm.summary_fr as string) : undefined;
// Two works one PDF printed together (86 split them).
const publishedWith = fm.published_with ? await workAt(fm.published_with as string) : undefined;

const category = categoryOf(entry);
const refs = refsOf(entry);
const read = minutes(entry);
const count = refs.length > 1 ? `${refs.length} références` : refs.length ? "1 référence" : undefined;
// Home, the work's list, then its year (a Ghost tag) or its archive.
const yearTag = fm.source === "mevar" ? tags.get(String(fm.year)) : undefined;
const crumbs = [
  { href: "/", label: "Accueil" },
  ...(category ? [{ href: `/${category.slug}/`, label: category.title }] : []),
  ...(yearTag && fm.tags?.includes(yearTag.name) ? [{ href: yearTag.url, label: yearTag.name }] : []),
  ...(category && !isMevar(entry) ? [{ href: `/${category.slug}/archives/${fm.source}/`, label: ARCHIVE_SOURCES[fm.source!] }] : []),
];
// The sections of the text, for the rail: its highest level of heading.
const depth = Math.min(...headings.map((h) => h.depth));
const toc = headings.filter((h) => h.depth === depth);
const after = await nextWorks(entry, next);
const groups = [
  { label: "Thèmes", items: (fm.tags ?? []).map((t) => ({ label: t, href: fm.source === "mevar" ? tags.get(t)?.url : undefined })) },
  { label: "Personnes", items: (fm.persons ?? []).map((label) => ({ label, href: undefined })) },
  { label: "Lieux", items: (fm.places ?? []).map((label) => ({ label, href: undefined })) },
  { label: "Sujets", items: (fm.themes ?? []).map((label) => ({ label, href: undefined })) },
].filter((g) => g.items.length);
---

<Layout
  title={`${title} · Mevar`}
  description={excerptOf(entry)}
  image={fm.local_image ? `/${fm.local_image}` : undefined}
  lang={lang}
  article={{ published, author: preacher }}
>
  <JsonLd
    slot="head"
    data={{
      "@type": "Article",
      headline: title,
      description: excerptOf(entry),
      inLanguage: lang,
      datePublished: published,
      image: fm.local_image && new URL(`/${fm.local_image}`, Astro.site).href,
      mainEntityOfPage: new URL(workUrl(entry), Astro.site).href,
      author: preacher && {
        "@type": "Person",
        name: preacher,
        url: author && authorCount ? new URL(`/auteurs/${author.slug}/`, Astro.site).href : undefined,
      },
      // The mission publishes its own texts; an archive text is another's, kept here with permission.
      publisher: isMevar(entry) ? { "@type": "Organization", name: "MEVAR", url: Astro.site!.href } : undefined,
    }}
  />
  <Fragment slot="bar">
    <BackBar href={category ? `/${category.slug}/` : "/"} label={category?.title ?? "Accueil"}>
      <button type="button" class="round-btn js-type" aria-label="Taille du texte"><Icon name="type" size={14} /></button>
      <button type="button" class="round-btn js-save" aria-label="Enregistrer dans Mes lectures" aria-pressed="false"><Icon name="bookmark" size={14} /></button>
      <button type="button" class="round-btn js-share" aria-label="Partager"><Icon name="share-2" size={14} /></button>
    </BackBar>
  </Fragment>
  <div slot="progress" class="h-[3px] bg-line max-lg:h-0.5"><div class="js-progress h-full w-0 bg-accent"></div></div>

  <article data-pagefind-body data-work data-title={title} data-category={category?.title ?? ""}>
    {preacher && <meta data-pagefind-filter="preacher[content]" content={preacher} />}
    {fm.year && <meta data-pagefind-filter="year[content]" content={String(fm.year)} />}
    {fm.source && <meta data-pagefind-filter="source[content]" content={fm.source} />}
    <meta data-pagefind-filter="collection[content]" content={isMevar(entry) ? "Mevar" : "Archives"} />
    {category && <meta data-pagefind-meta="category[content]" content={category.title} />}
    <meta data-pagefind-meta="about[content]" content={dots(shortDate(entry), `${read} min de lecture`)} />

    <!-- Header: only the title is indexed, as the result's title -->
    <header class="mx-auto flex max-w-[1440px] flex-col gap-[26px] px-[84px] max-xl:px-10 pt-[52px] pb-9 max-lg:gap-3 max-lg:px-5 max-lg:pt-4 max-lg:pb-4" data-pagefind-ignore>
      <Crumbs crumbs={crumbs} />
      <div class="flex flex-col gap-5 max-lg:gap-3">
        <p class="text-[11px] leading-[13px] font-semibold tracking-[2px] text-accent uppercase max-lg:text-[9px] max-lg:leading-[11px] max-lg:tracking-[1.6px]">{fm.subtitle ?? kindLabel(entry)}</p>
        <h1 class="max-w-[1020px] font-display text-[70px] leading-[71px] max-lg:text-[40px] max-lg:leading-[41px]" data-pagefind-meta="title">{title}</h1>
      </div>
      <div class="flex items-center justify-between gap-4 border-t pt-[22px] max-lg:border-t-0 max-lg:border-b max-lg:pt-1 max-lg:pb-3.5">
        <div class="flex min-w-0 items-center gap-3.5 max-lg:gap-[11px]">
          {preacher && <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink font-display text-[19px] text-on-invert max-lg:size-[34px] max-lg:text-base">{preacher[0]}</span>}
          <p class="flex min-w-0 flex-col gap-0.5 text-[13px] leading-4 text-ink-2 max-lg:gap-px max-lg:text-[11px] max-lg:leading-[13px]">
            {preacher && (author && authorCount
              ? <a href={`/auteurs/${author.slug}/`} class="text-[15px] leading-[18px] font-semibold text-ink max-lg:text-[13px] max-lg:leading-4">{preacher}</a>
              : <span class="text-[15px] leading-[18px] font-semibold text-ink max-lg:text-[13px] max-lg:leading-4">{preacher}</span>)}
            <span class="max-lg:hidden">{dots(date, fm.location, fm.duration, `${read} min de lecture`, count)}</span>
            <span class="lg:hidden">{dots(shortDate(entry), fm.location, `${read} min`, count)}</span>
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-2.5" data-noprint>
          {pdf && (
            <a href={pdf} class="hair flex items-center gap-2 rounded-full px-[18px] py-[11px] text-sm leading-[17px] font-medium max-lg:gap-1.5 max-lg:px-[13px] max-lg:py-2 max-lg:text-xs max-lg:leading-[15px]">
              <Icon name="download" class="max-lg:size-[13px]" /> PDF
            </a>
          )}
          <button type="button" class="round-btn js-share max-lg:hidden" aria-label="Partager"><Icon name="share-2" /></button>
          <button type="button" class="round-btn js-save max-lg:hidden" aria-label="Enregistrer dans Mes lectures" aria-pressed="false"><Icon name="bookmark" /></button>
          <button type="button" class="round-btn js-type max-lg:hidden" aria-label="Taille du texte"><Icon name="type" /></button>
        </div>
      </div>
    </header>

    {fm.local_image && (
      <div class="mx-auto max-w-[1440px] px-[84px] max-xl:px-10 max-lg:px-5" data-pagefind-ignore>
        <img src={`/${fm.local_image}`} alt="" class="h-[440px] w-full rounded-3xl bg-tint object-cover max-lg:h-[168px] max-lg:rounded-2xl" />
      </div>
    )}

    <div class="mx-auto flex max-w-[1440px] items-start justify-between gap-10 px-[84px] max-xl:px-10 pt-[60px] pb-[76px] max-lg:flex-col max-lg:items-stretch max-lg:gap-8 max-lg:px-5 max-lg:pt-5 max-lg:pb-10">
      <aside class="sticky top-[120px] flex w-[196px] shrink-0 flex-col gap-7 max-xl:hidden" data-pagefind-ignore data-noprint>
        {toc.length > 1 && (
          <nav class="flex flex-col gap-3.5" aria-label="Dans ce texte">
            <p class="eyebrow">Dans ce texte</p>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class="js-toc border-l-2 py-0.5 pl-3 text-[13px] leading-5 text-ink-2 hover:text-ink aria-[current]:border-accent aria-[current]:text-ink">{h.text}</a>
            ))}
          </nav>
        )}
        <div class:list={["flex flex-col gap-3", toc.length > 1 && "border-t pt-6"]}>
          <p class="eyebrow">Partager</p>
          <p class="flex items-center gap-2">
            <button type="button" class="round-btn js-copy" aria-label="Copier le lien"><Icon name="link" /></button>
            <a href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(new URL(workUrl(entry), Astro.site).href)}`} class="round-btn" aria-label="Envoyer par e-mail"><Icon name="mail" /></a>
            <button type="button" class="round-btn js-print" aria-label="Imprimer"><Icon name="printer" /></button>
          </p>
        </div>
      </aside>

      <div class="w-[648px] max-w-full min-w-0 max-lg:w-auto">
        {(fm.summary || original || publishedWith || summaryFr || audio || remoteAudio || video || series.length > 1) && (
          <div class="mb-[30px] flex flex-col gap-4 text-sm leading-[22px] text-ink-2" data-pagefind-ignore>
            {fm.summary && <p class="font-read text-lg leading-7 text-ink italic">{fm.summary}</p>}
            {original && (
              <p>Résumé de la prédication <a href={workUrl(original)} class="text-ink underline decoration-accent underline-offset-4">« {original.data.title} »</a> (texte original en anglais).</p>
            )}
            {publishedWith && (
              <p>Publié avec <a href={workUrl(publishedWith)} class="text-ink underline decoration-accent underline-offset-4">« {publishedWith.data.title} »{publishedWith.data.title === fm.title && publishedWith.data.subtitle ? ` (${publishedWith.data.subtitle})` : ""}</a>, dans le même document.</p>
            )}
            {summaryFr && (
              <p>Résumé en français&nbsp;: <a href={workUrl(summaryFr)} class="text-ink underline decoration-accent underline-offset-4">« {summaryFr.data.title} »</a>.</p>
            )}
            {(remoteAudio || video) && (
              <p class="flex flex-wrap gap-2 font-medium text-ink" data-noprint>
                {remoteAudio && <a href={remoteAudio} class="hair flex items-center gap-2 rounded-full px-[18px] py-[11px] leading-[17px]"><Icon name="volume-2" /> Audio</a>}
                {video && <a href={video} class="hair flex items-center gap-2 rounded-full px-[18px] py-[11px] leading-[17px]"><Icon name="play" /> Vidéo</a>}
              </p>
            )}
            {/* nothing is loaded until the reader plays it */}
            {audio && <audio controls preload="none" src={audio} class="w-full" aria-label={`Écouter « ${title} »`} data-noprint></audio>}
            {series.length > 1 && (
              <nav class="rounded-2xl bg-tint p-[22px]" aria-label={`Série ${fm.series}`} data-noprint>
                {/* /series/ lists Mevar's series; an archive's has no place there. */}
                <p class="eyebrow mb-3.5">
                  {isMevar(entry) ? <a href={`/series/#${slug(fm.series as string)}`} class="hover:text-ink">{dots("Série", fm.series)}</a> : dots("Série", fm.series)}
                </p>
                <ol class="flex flex-col text-[13px] leading-4 font-medium">
                  {series.map((e) => (
                    <li class="border-rail-line py-2.5 not-first:border-t">
                      {e.id === entry.id
                        ? <strong aria-current="page" class="font-semibold text-accent">{e.data.title}</strong>
                        : <a href={workUrl(e)} class="text-ink hover:text-accent">{e.data.title}</a>}
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </div>
        )}

        <!-- Body -->
        <div class="prose-reader js-prose">
          <Content />
        </div>

        <div class="mt-11 flex flex-col gap-6 border-t pt-11 max-lg:mt-8 max-lg:pt-8" data-pagefind-ignore data-noprint>
          {(previous || next) && (
            <nav class="grid grid-cols-2 gap-4 text-sm leading-[22px]" aria-label="Série">
              <div>
                {previous && (
                  <a href={workUrl(previous)} class="flex flex-col gap-1 hover:text-accent">
                    <span class="eyebrow flex items-center gap-2"><Icon name="arrow-left" size={13} /> Partie précédente</span>{previous.data.title}
                  </a>
                )}
              </div>
              <div class="text-right">
                {next && (
                  <a href={workUrl(next)} class="flex flex-col items-end gap-1 hover:text-accent">
                    <span class="eyebrow flex items-center gap-2">Partie suivante <Icon name="arrow-right" size={13} /></span>{next.data.title}
                  </a>
                )}
              </div>
            </nav>
          )}

          {refs.length > 0 && (
            <section id="ecritures" class="hair flex flex-col rounded-[18px] p-[26px] max-lg:p-5">
              <details class="group">
                <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2 [&::-webkit-details-marker]:hidden">
                  <h2 class="eyebrow">Les Écritures de ce texte</h2>
                  {refs.length > 5 && <span class="text-[13px] leading-4 font-medium text-accent group-open:hidden">Index complet des {refs.length} références</span>}
                </summary>
                <p class="flex flex-wrap gap-2 pt-4">
                  {refs.map((r) => <a href={refUrl(r)} class="ref px-[13px] py-2">{r}</a>)}
                </p>
              </details>
              <p class="flex flex-wrap items-center gap-2 pt-4 text-xs leading-[15px] font-medium text-ink-2 [details[open]+&]:hidden">
                {refs.slice(0, 5).map((r) => <a href={refUrl(r)} class="ref px-[13px] py-2">{r}</a>)}
                {refs.length > 5 && <span>+ {refs.length - 5} autres</span>}
              </p>
            </section>
          )}

          {groups.map((g) => (
            <div class="flex flex-wrap items-center gap-2">
              <p class="eyebrow pr-2">{g.label}</p>
              {g.items.map((t) => t.href ? <a href={t.href} class="ref">{t.label}</a> : <span class="ref">{t.label}</span>)}
            </div>
          ))}

          {author && authorCount > 0 && (
            <section class="flex items-center gap-[18px] rounded-[18px] bg-dark p-[26px] text-on-dark max-lg:flex-wrap max-lg:p-5">
              <span class="flex size-[52px] shrink-0 items-center justify-center rounded-full bg-dark-2 font-display text-2xl shadow-[inset_0_0_0_1px_var(--hairline)]">{author.name[0]}</span>
              <div class="flex min-w-0 flex-1 flex-col gap-1">
                <h2 class="font-display text-2xl leading-[31px]">{author.name}</h2>
                <p class="text-sm leading-[22px] text-on-dark-2">{authorCount.toLocaleString("fr-FR")} texte{authorCount > 1 ? "s" : ""} publié{authorCount > 1 ? "s" : ""} sur le site.</p>
              </div>
              <a href={`/auteurs/${author.slug}/`} class="flex shrink-0 items-center gap-2 rounded-full px-5 py-3 text-sm leading-[17px] font-medium shadow-[inset_0_0_0_1px_var(--stroke)]">
                Tous ses textes <Icon name="arrow-right" />
              </a>
            </section>
          )}
        </div>
      </div>

      <aside class="sticky top-[120px] flex w-[280px] shrink-0 flex-col gap-[18px] max-lg:static max-lg:w-auto" data-pagefind-ignore data-noprint>
        {refs.length > 0 && (
          <section class="flex flex-col gap-3.5 rounded-2xl bg-tint p-[22px] max-lg:hidden">
            <h2 class="eyebrow">Écritures citées</h2>
            <ul class="flex flex-col text-[13px] leading-4 font-medium">
              {refs.slice(0, 7).map((r) => (
                <li class="border-rail-line not-first:border-t">
                  <a href={refUrl(r)} class="flex items-center justify-between py-2.5 hover:text-accent">{r}<Icon name="arrow-up-right" size={13} class="text-rail-icon" /></a>
                </li>
              ))}
            </ul>
            {refs.length > 7 && <a href="#ecritures" class="js-refs text-[13px] leading-4 font-semibold text-accent">Voir les {refs.length} références</a>}
          </section>
        )}
        {pdf && (
          <section class="hair flex flex-col gap-3.5 rounded-2xl p-[22px]">
            <span class="flex size-[38px] items-center justify-center rounded-xl bg-tint text-accent"><Icon name="file-text" size={17} /></span>
            <h2 class="font-display text-[21px] leading-6">{originalPdf ? "Le document d'origine" : "Le texte en PDF"}</h2>
            <p class="text-[13px] leading-5 text-ink-2">En PDF, à garder ou à imprimer.</p>
            <a href={originalPdf ?? pdf} class="flex items-center justify-center gap-2 rounded-full bg-ink px-[18px] py-3 text-sm leading-[17px] font-semibold text-on-invert">
              <Icon name="download" /> Télécharger
            </a>
          </section>
        )}
      </aside>
    </div>
  </article>

  {after.length > 0 && (
    <section class="bg-tint" data-noprint>
      <div class="mx-auto flex max-w-[1440px] flex-col gap-7 px-[84px] max-xl:px-10 pt-[60px] pb-[66px] max-lg:gap-1 max-lg:px-6 max-lg:py-8">
        <SectionHead eyebrow="Suite" title="À lire ensuite" href={category && `/${category.slug}/`} label={category?.title} plain small />
        <div class="grid grid-cols-2 gap-[22px] max-lg:grid-cols-1 max-lg:gap-0">
          {after.map((e) => <WorkCard entry={e} compact />)}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  import { keep } from "$lib/lectures";

  const article = document.querySelector<HTMLElement>("[data-work]")!;
  const prose = document.querySelector<HTMLElement>(".js-prose")!;
  const url = location.pathname;
  const all = <T extends Element>(selector: string) => [...document.querySelectorAll<T>(selector)];

  // Mes lectures: this text was opened now; how far it was read is kept as
  // the reader leaves it.
  const mine = keep(url, { title: article.dataset.title, category: article.dataset.category, opened: new Date().toISOString() });
  let progress = mine.progress ?? 0;

  const bars = all<HTMLElement>(".js-progress");
  const toc = all<HTMLAnchorElement>(".js-toc");
  function scrolled() {
    const { top, height } = prose.getBoundingClientRect();
    // A work that is only a recording has no text to be read through.
    if (!height) return;
    const read = Math.min(1, Math.max(0, (innerHeight - top) / height));
    for (const bar of bars) bar.style.width = `${read * 100}%`;
    progress = Math.max(progress, Math.round(read * 100));
    // The section being read: the last heading above the middle of the screen.
    const current = toc.findLast((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))!.getBoundingClientRect().top < innerHeight / 2) ?? toc[0];
    for (const a of toc) a === current ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current");
  }
  addEventListener("scroll", scrolled, { passive: true });
  scrolled();
  addEventListener("pagehide", () => keep(url, { progress }));

  for (const button of all(".js-save")) {
    button.setAttribute("aria-pressed", String(!!mine.saved));
    button.addEventListener("click", () => {
      const { saved } = keep(url, { saved: button.getAttribute("aria-pressed") !== "true" });
      for (const b of all(".js-save")) b.setAttribute("aria-pressed", String(!!saved));
    });
  }

  // Three sizes of text, kept for every work (Layout.astro applies the choice).
  for (const button of all(".js-type")) {
    button.addEventListener("click", () => {
      const scale = { "1": "1.15", "1.15": "1.3", "1.3": "1" }[localStorage.getItem("read-scale") ?? "1"]!;
      localStorage.setItem("read-scale", scale);
      document.documentElement.style.setProperty("--read-scale", scale);
    });
  }

  const copy = (button: Element) => navigator.clipboard.writeText(location.href).then(() => {
    const label = button.getAttribute("aria-label")!;
    button.setAttribute("aria-label", "Lien copié");
    button.toggleAttribute("data-done", true);
    setTimeout(() => { button.setAttribute("aria-label", label); button.toggleAttribute("data-done", false); }, 2000);
  });
  for (const button of all(".js-copy")) button.addEventListener("click", () => copy(button));
  for (const button of all(".js-share")) {
    button.addEventListener("click", () => navigator.share ? navigator.share({ title: document.title, url: location.href }).catch(() => {}) : copy(button));
  }
  for (const button of all(".js-print")) button.addEventListener("click", () => print());
  // « Voir les 50 références » opens the full index it jumps to.
  for (const link of all(".js-refs")) link.addEventListener("click", () => document.querySelector("#ecritures details")!.setAttribute("open", ""));
</script>
