---
// Under 1024px, the offer to install the site as an app, when the browser
// says it can be (`beforeinstallprompt`) and the reader has not answered yet.
import Icon from "./Icon.astro";

const perks = [
  ["smartphone", "Une icône sur l'écran d'accueil"],
  ["cloud-off", "Les textes déjà lus restent lisibles hors ligne"],
  ["gauge", "Rien n'est téléchargé en bloc, pensé pour les forfaits limités"],
] as const;
---

<dialog id="install" tabindex="-1" class="m-0 mt-auto outline-none w-full max-w-none rounded-t-[26px] bg-bg px-[22px] pt-3 pb-[calc(10px+env(safe-area-inset-bottom))] text-ink backdrop:bg-[#141110a6] lg:hidden" aria-labelledby="install-title">
  <div class="mx-auto flex max-w-md flex-col items-center gap-3.5">
    <span class="h-1 w-11 rounded-full bg-line"></span>
    <span class="flex size-[60px] items-center justify-center rounded-2xl bg-[#141110]">
      <img src="/brand/logo-white.svg" alt="" width="38" height="38" loading="lazy" />
    </span>
    <div class="flex flex-col items-center gap-2 text-center">
      <h2 id="install-title" class="font-display text-3xl leading-9">Installer Mevar</h2>
      <p class="text-[13.5px] leading-[21px] text-ink-2">L'application s'ouvre en plein écran, sans barre d'adresse, et garde les textes que vous avez ouverts.</p>
    </div>
    <ul class="flex w-full flex-col gap-2.5 pt-1 text-[13px] leading-4">
      {perks.map(([icon, label]) => (
        <li class="flex items-center gap-2.5">
          <span class="flex size-[26px] shrink-0 items-center justify-center rounded-full bg-tint text-accent"><Icon name={icon} size={13} /></span>{label}
        </li>
      ))}
    </ul>
    <form method="dialog" class="flex w-full flex-col gap-2 pt-2">
      <button value="install" class="flex h-[50px] cursor-pointer items-center justify-center gap-2 rounded-full bg-accent-fill text-[15px] font-semibold text-on-accent">
        <Icon name="arrow-down-to-line" size={16} /> Installer
      </button>
      <button value="later" class="h-[46px] cursor-pointer rounded-full text-sm font-medium text-ink-2">Plus tard</button>
    </form>
  </div>
</dialog>

<script>
  const sheet = document.getElementById("install") as HTMLDialogElement;
  window.addEventListener("beforeinstallprompt", (event) => {
    // Our sheet, not the browser's banner; once answered, never again: a
    // browser that adds a shortcut and installs nothing (Brave, Firefox)
    // offers the installation at every page, and so did we.
    event.preventDefault();
    if (localStorage.getItem("install") || !matchMedia("(width < 64rem)").matches) return;
    sheet.showModal();
    sheet.focus();
    sheet.addEventListener("close", () => {
      localStorage.setItem("install", sheet.returnValue || "later");
      // @ts-expect-error prompt() is on the BeforeInstallPromptEvent, which TypeScript's DOM types lack
      if (sheet.returnValue === "install") event.prompt();
    }, { once: true });
  });
</script>
