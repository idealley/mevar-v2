---
// The "Publications" signup, posted to functions/api/subscribe.ts. `origin`
// tells the two forms apart in Resend.
import Icon from "./Icon.astro";

interface Props {
  origin: "newsletter-footer" | "newsletter-page";
}
const { origin } = Astro.props;
---

<form class="newsletter-form flex max-w-full flex-wrap items-center justify-center gap-2.5" data-origin={origin}>
  <label class="sr-only" for={`email-${origin}`}>Adresse e-mail</label>
  <input
    id={`email-${origin}`}
    name="email"
    type="email"
    required
    autocomplete="email"
    placeholder="votre@email.com"
    class="hair w-[330px] max-w-full rounded-full bg-surface px-[22px] py-[15px] text-[15px] leading-[18px] placeholder:text-muted"
  />
  <button type="submit" class="flex cursor-pointer items-center gap-2 rounded-full bg-accent-fill px-6 py-3.5 text-[15px] leading-[18px] font-semibold text-on-accent disabled:opacity-60">
    S'abonner <Icon name="arrow-right" size={16} />
  </button>
  <p class="mt-3 basis-full text-center text-[13px] leading-4 text-ink-2" role="status">
    Pas de publicité, pas de partage d'adresse. Désinscription par le lien en bas de chaque e-mail.
  </p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(".newsletter-form")) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector("[role=status]")!;
      const button = form.querySelector("button")!;
      button.disabled = true;
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email: new FormData(form).get("email"), origin: form.dataset.origin }),
      }).catch(() => null);
      button.disabled = false;
      if (res?.ok) {
        form.reset();
        status.textContent = "Merci, votre inscription est enregistrée.";
      } else if (res?.status === 400) {
        status.textContent = "Cette adresse e-mail ne semble pas valide.";
      } else {
        status.textContent = "L'inscription n'a pas abouti. Réessayez dans un instant.";
      }
    });
  }
</script>
