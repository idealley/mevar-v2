---
// Where a page is: home, then the lists that lead to it. Shown from 1024px,
// and told to search engines at every width.
import Icon from "./Icon.astro";
import JsonLd from "./JsonLd.astro";

interface Props {
  crumbs: { href: string; label: string }[];
}
---

<nav class="flex flex-wrap items-center gap-[9px] text-[13px] leading-4 text-ink-2 max-lg:hidden" aria-label="Fil d'Ariane" data-noprint>
  {Astro.props.crumbs.map((c, i) => (
    <>
      {i > 0 && <Icon name="chevron-right" size={13} class="text-dim" />}
      <a href={c.href} class="hover:text-ink">{c.label}</a>
    </>
  ))}
</nav>
<JsonLd
  data={{
    "@type": "BreadcrumbList",
    itemListElement: Astro.props.crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.label,
      item: new URL(c.href, Astro.site).href,
    })),
  }}
/>
