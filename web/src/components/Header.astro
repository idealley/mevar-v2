---
// The site header. From 1024px: the brand, the lists and the actions (search,
// « Mes lectures », the theme, the newsletter: under 1024px the first two are
// in the tab bar), with the reading progress of a work below. Under 1024px:
// the bar a page brings
// (slot "bar": the brand on the home page, the way back on a work); a page
// with a title of its own brings none.
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  ["/predications/", "Prédications"],
  ["/exhortations/", "Exhortations"],
  ["/etudes-bibliques/", "Études bibliques"],
  ["/publications/", "Publications"],
  ["/bible/", "Écritures"],
  ["/auteurs/", "Auteurs"],
  ["/a-propos/", "À propos"],
];
const here = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-bg pt-[env(safe-area-inset-top)]" data-noprint>
  <div class="mx-auto hidden max-w-[1440px] items-center justify-between px-10 py-[22px] lg:flex">
    <Brand />
    <nav class="flex items-center gap-7 text-sm font-medium max-xl:gap-4" aria-label="Rubriques">
      {links.map(([href, label]) => (
        <a href={href} aria-current={here.startsWith(href) ? "page" : undefined} class="text-ink-2 hover:text-ink aria-[current]:text-ink">{label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/recherche/" class="round-btn" aria-label="Recherche"><Icon name="search" /></a>
      <a href="/mes-lectures/" class="round-btn" aria-label="Mes lectures"><Icon name="bookmark" /></a>
      <ThemeToggle />
      <a href="/newsletter/" class="flex items-center gap-[7px] rounded-full bg-ink px-[18px] py-2.5 text-sm leading-[17px] font-medium text-on-invert">
        S'abonner <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  </div>
  <div class="lg:hidden">
    <slot name="bar" />
  </div>
  <slot name="progress" />
</header>
