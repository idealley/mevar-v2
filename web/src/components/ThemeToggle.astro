---
// Light or dark. Layout.astro applies the stored choice before the first
// paint; this button changes it.
import Icon from "./Icon.astro";
---

<button type="button" class="round-btn js-theme" aria-label="Changer de thème, clair ou sombre">
  <Icon name="moon" class="dark:hidden max-lg:size-3.5" />
  <Icon name="sun" class="hidden dark:block max-lg:size-3.5" />
</button>

<script>
  for (const button of document.querySelectorAll(".js-theme")) {
    button.addEventListener("click", () => {
      const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = theme;
      localStorage.setItem("theme", theme);
    });
  }
</script>
