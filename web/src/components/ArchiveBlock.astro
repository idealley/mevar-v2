---
// Below a category's Mevar list, on every page of it: the archive of that
// category, a count and a link per source.
import Icon from "./Icon.astro";
import { ARCHIVE_SOURCES, type WorkEntry } from "$lib/works";

interface Props {
  category: string;
  archive: { source: string; works: WorkEntry[] }[];
}

const { category, archive } = Astro.props;
---

{archive.length > 0 && (
  <aside class="mt-14 flex max-w-[648px] flex-col gap-3.5 rounded-2xl bg-tint p-[22px] max-lg:mt-8" aria-labelledby="archives">
    <h2 id="archives" class="eyebrow">Archives</h2>
    <p class="text-sm leading-[22px] text-ink-2">
      Des textes de contexte et d'histoire, à côté des publications de la mission.
    </p>
    <ul class="flex flex-col text-[13px] leading-4 font-medium">
      {archive.map((a) => (
        <li class="border-rail-line not-first:border-t">
          <a href={`/${category}/archives/${a.source}/`} class="flex items-center justify-between gap-4 py-2.5 hover:text-accent">
            {ARCHIVE_SOURCES[a.source]}
            <span class="flex items-center gap-3 font-normal text-ink-2">{a.works.length.toLocaleString("fr-FR")}<Icon name="arrow-up-right" size={13} class="text-rail-icon" /></span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
