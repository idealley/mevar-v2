---
// The card of a work in a list (docs/website.pen, « Cartes et images »): a
// band on top, the work's image or else its main Scripture reference on a
// dark panel, and the text on a plain ground below. Under 1024px a card is a
// row of text: no band, no image fetched.
import Icon from "./Icon.astro";
import { refUrl } from "$lib/bible.mjs";
import { categoryOf, dots, excerptOf, minutes, preacherOf, refsOf, shortDate, workUrl, type WorkEntry } from "$lib/works";

interface Props {
  entry: WorkEntry;
  /** The small card under a work: no excerpt, no references. */
  compact?: boolean;
}

const { entry, compact } = Astro.props;
const fm = entry.data;
const refs = refsOf(entry);
const date = shortDate(entry);
const read = `${minutes(entry)} min de lecture`;
const category = categoryOf(entry);
const excerpt = !compact && excerptOf(entry);
---

<article
  class:list={[
    "work-card hair relative flex flex-col overflow-hidden rounded-[20px] bg-surface",
    compact ? "lg:min-h-[300px]" : "lg:min-h-[498px]",
    "max-lg:rounded-none max-lg:border-t max-lg:bg-transparent max-lg:py-[17px] max-lg:shadow-none",
  ]}
>
  {fm.local_image ? (
    <img
      src={`/${fm.local_image}`}
      alt=""
      loading="lazy"
      decoding="async"
      class:list={["w-full bg-tint object-cover max-lg:hidden", compact ? "h-[150px]" : "h-[184px]"]}
    />
  ) : (
    <div class:list={["flex flex-col justify-end bg-panel max-lg:hidden", compact ? "h-[150px] gap-1.5 p-[22px]" : "h-[184px] gap-2 p-6"]}>
      <p class="text-[9px] leading-[11px] font-semibold tracking-[1.8px] text-dim uppercase">
        {refs.length ? "Référence principale" : (preacherOf(entry) ?? "Mevar")}
      </p>
      <p class:list={["font-display text-on-dark", compact ? "text-[28px] leading-[29px]" : "text-[33px] leading-[35px]"]}>
        {refs[0] ?? fm.year}
      </p>
    </div>
  )}
  <div class:list={["flex flex-1 flex-col justify-between max-lg:gap-[7px] max-lg:p-0", compact ? "gap-[5px] p-[22px]" : "gap-[18px] p-[26px]"]}>
    <div class:list={["flex flex-col max-lg:gap-[7px]", compact ? "gap-[9px]" : "gap-3"]}>
      {category && <p class="cat max-lg:text-[9px] max-lg:tracking-[1.6px]">{category.title}</p>}
      <h3 class:list={["font-display max-lg:text-[21px] max-lg:leading-[25px]", compact ? "text-[23px] leading-[26px]" : "text-[26px] leading-[30px]"]}>
        <a href={workUrl(entry)} class="after:absolute after:inset-0">{fm.title ?? entry.id}</a>
      </h3>
      {excerpt && <p class="line-clamp-2 text-sm leading-[23px] text-ink-2 max-lg:hidden">{excerpt}</p>}
    </div>
    <div class="flex flex-col gap-[18px]">
      {!compact && refs.length > 0 && (
        <p class="relative flex flex-wrap gap-2 max-lg:hidden">
          {refs.slice(0, 2).map((r) => <a href={refUrl(r)} class="ref">{r}</a>)}
        </p>
      )}
      <div class:list={["flex items-center justify-between", !compact && "lg:border-t lg:pt-4"]}>
        <p class:list={["text-ink-2 max-lg:text-xs max-lg:leading-[15px]", compact ? "text-xs leading-[15px]" : "text-[13px] leading-4"]}>
          {compact
            ? dots(date, read)
            : <><span class="max-lg:hidden">{dots(preacherOf(entry), read)}</span><span class="lg:hidden">{dots(date, read)}</span></>}
        </p>
        <span class:list={["flex items-center justify-center rounded-full bg-ink text-on-invert max-lg:hidden", compact ? "size-8" : "size-[38px]"]}>
          <Icon name="arrow-up-right" size={compact ? 14 : 15} />
        </span>
      </div>
    </div>
  </div>
</article>
