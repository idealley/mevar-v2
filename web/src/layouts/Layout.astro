---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TabBar from "../components/TabBar.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: "fr" | "en";
  /** A work: Open Graph calls it an article, with its date and its author's page. */
  article?: { published?: string; author?: string };
}

const {
  title = "Mevar — Étude de la Parole pour le temps de la fin",
  description = "Bibliothèque numérique de prédications, exhortations, études bibliques et livres autour du message du temps de la fin.",
  image,
  lang = "fr",
  article,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// dist/404.html answers for every unknown path: it has no address of its own.
const found = Astro.url.pathname !== "/404/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Before the first paint: the theme (the reader's choice, or else the
         system's) and the size the reader chose for a text. -->
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.style.setProperty("--read-scale", localStorage.getItem("read-scale") ?? 1);
    </script>
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline defer src="/registerSW.js"></script>
    <meta name="theme-color" content="#141110" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {found && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Mevar" href="/rss/index.xml" />

    <!-- Open Graph, and the card other networks draw from it. A page
         without an image of its own shows the mark. -->
    <meta property="og:site_name" content="Mevar" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_FR"} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {found && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image ?? "/brand/icon-512.png", Astro.site)} />
    {article?.published && <meta property="article:published_time" content={article.published} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />

    <slot name="head" />

    {/* Google Analytics, the property mevar.org has counted its visits in
        since Ghost (goal 29): how the site grows, not who reads. On the
        built site only. Its script is fetched once the page has loaded, so
        that neither the text nor the service worker waits for Google. */}
    {import.meta.env.PROD && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("js", new Date());
        // Visits, not advertising profiles: no Google signals, no ad personalisation.
        gtag("config", "G-D3TVDDZ8H7", { allow_google_signals: false, allow_ad_personalization_signals: false });
        addEventListener("load", () => {
          const tag = document.createElement("script");
          tag.async = true;
          tag.src = "https://www.googletagmanager.com/gtag/js?id=G-D3TVDDZ8H7";
          document.head.append(tag);
        });
      </script>
    )}
  </head>

  <body class="antialiased">
    <Header>
      <slot name="bar" slot="bar" />
      <slot name="progress" slot="progress" />
    </Header>
    <main class="min-h-[60vh] max-lg:min-h-[calc(100dvh-130px)]">
      <slot />
    </main>
    <Footer />
    <TabBar />
  </body>
</html>
